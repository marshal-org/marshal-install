# =============================================================================
# gcp-gke — example tfvars
# =============================================================================
# Copy to terraform.tfvars in the gcp-gke/ dir and fill in.
#
#   gcloud auth application-default login
#   cp examples/gcp-gke.tfvars.example gcp-gke/terraform.tfvars
#   cd gcp-gke && terraform init && terraform apply
#
# Default posture below: reuse an existing cluster, external Cloud SQL Postgres,
# bundled (in-cluster) Redis. To PROVISION a private cluster instead, see the
# "Provision a private cluster" block at the bottom.
# =============================================================================

# ── GKE cluster to target ────────────────────────────────────────────────────
project_id   = "acme-prod"
cluster_name = "acme-gke"
location     = "europe-west1" # region (regional cluster) or zone (zonal cluster)

# ── From your Marshal onboarding ─────────────────────────────────────────────
installation_jwt    = "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9…"
deployment_id       = "dep_ab12cd"
registry_pull_token = "mrpt_9f3c…"

# ── Product version + routing ────────────────────────────────────────────────
chart_version = "0.27.0" # the version this installer was published for; confirm against your onboarding
ingress_host  = "marshal.acme.com"

# ── Datastores: external Postgres + bundled Redis (recommended) ──────────────
# Postgres is the durable source of truth → managed Cloud SQL (private IP).
database_mode = "external"
database_url  = "postgres://marshal:PW@10.20.0.5:5432/marshal?sslmode=require"
# Redis holds only ephemeral/reconstructible state → in-cluster is the default.
redis_mode = "bundled"
# To instead point at managed Memorystore:
# redis_mode = "external"
# redis_url  = "redis://10.30.0.4:6379"

# ── Ingress / TLS ────────────────────────────────────────────────────────────
# Marshal is internal-only by default (internal LB, IngressClass gce-internal).
# internal_ingress = true   # default; set false to expose via an external GCLB
# The internal static IP is reserved and wired for you (create_ingress_static_ip).
# Google-managed, auto-renewing certificate (chart >= 0.27.0): serve through a
# Gateway instead of the Ingress. See README "Google-managed certificate".
# ingress_mode               = "gateway"
# create_managed_certificate = true
# Or bring your own TLS Secret:
# ingress_tls = [{ hosts = ["marshal.acme.com"], secretName = "marshal-tls" }]

# ── Registry (default: direct pull from registry.marshal.codes) ──────────────
# Recommended at scale — mirror through a GCP AR remote repo + Workload Identity:
# registry           = "europe-west1-docker.pkg.dev/acme-prod/marshal-cache/marshal"
# registry_auth_mode = "workloadIdentity"

# ── Object storage — recommended: turn on both ──────────────────────────────
# Both default to false. Without the spaces bucket, spaces cannot be forked or
# archived, and keep files across stop/resume only on a persistent-disk size; without the audit bucket, the audit log is never
# exported. Access is keyless (a <cluster_name>-storage GSA via Workload
# Identity). After install an owner or admin connects each bucket in
# Settings > Space Storage / Settings > Auditing. See gcp-gke/README.md.
# create_spaces_persistence_bucket = true
# create_audit_persistence_bucket  = true

# ── Session port-previews (optional) ─────────────────────────────────────────
# preview_domain = "preview.acme.com"

# ── Webhook Relay + Slack (Auth Broker) — both optional, both default OFF ────
# Leaving these unset doesn't error — Settings > Webhooks / Settings > Slack
# just 404 in the UI with no other signal. Decide explicitly instead of
# discovering the gap live. Both need outbound 443 from the cluster to
# whichever host they point at (hooks.marshal.codes / auth.marshal.codes by
# default — Marshal's hosted tier).
# webhook_relay_enabled = true
# auth_broker_url       = "https://auth.marshal.codes"

# ── Provision a private cluster (instead of reusing one) ─────────────────────
# Uncomment to have Terraform create a private GKE cluster (private nodes +
# Cloud NAT + internal ingress), then install onto it. cluster_name becomes the
# name of the NEW cluster.
# deploy_cluster             = true
# master_authorized_networks = [{ cidr_block = "10.8.0.0/24", display_name = "admin-vpn" }]
# create_network             = true          # or false + network/subnetwork below
# spaces_pools = {
#   spaces = { machine_type = "e2-standard-4", disk_size_gb = 100, min_node_count = 1, max_node_count = 5 }
# }
# enable_private_endpoint    = true           # false = public endpoint, still authorized-only
# deletion_protection        = true
# When reusing an existing network:
# network                    = "acme-vpc"
# subnetwork                 = "acme-subnet"
# pods_range_name            = "pods"
# services_range_name        = "services"

# ── Reaching the control plane without a bastion ─────────────────────────────
# A private control plane normally means terraform and kubectl must run inside
# the VPC, which is why the flavor's README walks through a throwaway IAP
# bastion. Turning on the Google-managed DNS endpoint instead makes the control
# plane reachable from anywhere and gates it on the container.clusters.connect
# IAM permission, so master_authorized_networks may stay empty and never needs
# re-applying when your IP changes.
#
#   gcloud container clusters get-credentials <cluster> \
#     --location <loc> --dns-endpoint
#
# dns_endpoint_enabled = true

# ── Let ArgoCD own the release (provision only) ───────────────────────────────
# Build the cluster, registry cache, buckets and static IP, install nothing —
# see ../argocd/. Terraform still computes every cloud-derived chart value, so
# feed them to the Application from the output rather than retyping them:
#
#   terraform output -raw argocd_derived_values > values-derived.yaml
#
# deployment_id and registry_pull_token must still be REAL in this mode (the
# registry cache uses them as upstream credentials); only installation_jwt can
# be a placeholder.
# install_marshal = false
